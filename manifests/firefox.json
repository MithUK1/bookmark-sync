{
  "manifest_version": 3,
  "name": "Bookmark Sync",
  "version": "0.4.0",
  "description": "Keeps bookmarks in step across Chrome, Edge and Firefox through the Bookmark Sync helper on this computer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-sync@muk1",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["bookmarks", "alarms", "storage", "nativeMessaging"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Bookmark Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
