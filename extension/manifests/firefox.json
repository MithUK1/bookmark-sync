{
  "manifest_version": 3,
  "name": "Bookmarks Sync Plus",
  "version": "1.0.2",
  "description": "Keeps bookmarks in step across Chrome, Edge and Firefox through the Bookmarks Sync Plus helper on this computer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-sync@muk1",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["bookmarks", "alarms", "storage", "nativeMessaging"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Bookmarks Sync Plus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
